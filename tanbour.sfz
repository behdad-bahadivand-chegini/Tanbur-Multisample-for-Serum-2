// Tanbour: singles on C3-C4 (keys 48-60), G+C dyads on C5-C6 (keys 72-84)
// WAV files go in a 'samples' folder next to this .sfz (edit default_path if not)
// FOR PERSIA

<control>
default_path=Tanbur Samples/

<global>
loop_mode=no_loop
ampeg_attack=0.001
ampeg_release=0.4
amp_veltrack=60

<group>

<region>
sample=C.wav
lokey=48
hikey=48
pitch_keycenter=48

<region>
sample=C#.wav
lokey=49
hikey=49
pitch_keycenter=49

<region>
sample=D.wav
lokey=50
hikey=50
pitch_keycenter=50

<region>
sample=D#.wav
lokey=51
hikey=51
pitch_keycenter=51

<region>
sample=E.wav
lokey=52
hikey=52
pitch_keycenter=52

<region>
sample=F.wav
lokey=53
hikey=53
pitch_keycenter=53

<region>
sample=F#.wav
lokey=54
hikey=54
pitch_keycenter=54

<region>
sample=G.wav
lokey=55
hikey=55
pitch_keycenter=55

<region>
sample=G#.wav
lokey=56
hikey=56
pitch_keycenter=56

<region>
sample=A.wav
lokey=57
hikey=57
pitch_keycenter=57

<region>
sample=A#.wav
lokey=58
hikey=58
pitch_keycenter=58

<region>
sample=B.wav
lokey=59
hikey=59
pitch_keycenter=59

<region>
sample=C(oct).wav
lokey=60
hikey=60
pitch_keycenter=60

<group>

<region>
sample=G-C.wav
lokey=72
hikey=72
pitch_keycenter=72

<region>
sample=G#-C#.wav
lokey=73
hikey=73
pitch_keycenter=73

<region>
sample=A-D.wav
lokey=74
hikey=74
pitch_keycenter=74

<region>
sample=A#-D#.wav
lokey=75
hikey=75
pitch_keycenter=75

<region>
sample=B-E.wav
lokey=76
hikey=76
pitch_keycenter=76

<region>
sample=C-F.wav
lokey=77
hikey=77
pitch_keycenter=77

<region>
sample=C#-F#.wav
lokey=78
hikey=78
pitch_keycenter=78

<region>
sample=D-G.wav
lokey=79
hikey=79
pitch_keycenter=79

<region>
sample=D#-G#.wav
lokey=80
hikey=80
pitch_keycenter=80

<region>
sample=E-A.wav
lokey=81
hikey=81
pitch_keycenter=81

<region>
sample=F-A#.wav
lokey=82
hikey=82
pitch_keycenter=82

<region>
sample=F#-B.wav
lokey=83
hikey=83
pitch_keycenter=83

<region>
sample=G-C(oct).wav
lokey=84
hikey=84
pitch_keycenter=84
